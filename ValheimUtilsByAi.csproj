<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>ValheimUtilsByAi</AssemblyName>
    <RootNamespace>ValheimUtilsByAi</RootNamespace>
    <Version>0.0.24</Version>
    <BepInExPluginGuid>mh.ValheimUtilsByAi</BepInExPluginGuid>
    <BepInExPluginName>ValheimUtilsByAi</BepInExPluginName>
    <Description>AI-generated quality-of-life tweaks for Valheim. Every feature is toggleable in the BepInEx config.</Description>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <!-- The game assemblies are built against netstandard 2.1; take it from the game instead of the SDK's 2.0 facades (MSB3277). -->
    <ImplicitlyExpandNETStandardFacades>false</ImplicitlyExpandNETStandardFacades>
    <!-- Game assemblies: Steam client install or the free dedicated server (SteamCMD app 896660). Override: -p:ValheimManaged=... -->
    <ValheimManaged Condition="'$(ValheimManaged)' == ''">C:/Users/mateu/valheim_server/valheim_server_Data/Managed</ValheimManaged>
    <ThunderstoreDir>$(MSBuildProjectDirectory)\thunderstore</ThunderstoreDir>
    <PackageStageDir>$(BaseIntermediateOutputPath)thunderstore-stage\</PackageStageDir>
    <PackageZip>$(MSBuildProjectDirectory)\dist\$(AssemblyName)-$(Version).zip</PackageZip>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="BepInEx.PluginInfoProps" Version="2.1.0" />
    <PackageReference Include="JotunnLib" Version="2.30.2" ExcludeAssets="build" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="netstandard" HintPath="$(ValheimManaged)/netstandard.dll" Private="false" />
    <Reference Include="assembly_valheim" HintPath="$(ValheimManaged)/assembly_valheim.dll" Private="false" />
    <Reference Include="assembly_utils" HintPath="$(ValheimManaged)/assembly_utils.dll" Private="false" />
    <Reference Include="UnityEngine" HintPath="$(ValheimManaged)/UnityEngine.dll" Private="false" />
    <Reference Include="UnityEngine.CoreModule" HintPath="$(ValheimManaged)/UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="UnityEngine.AssetBundleModule" HintPath="$(ValheimManaged)/UnityEngine.AssetBundleModule.dll" Private="false" />
    <Reference Include="UnityEngine.PhysicsModule" HintPath="$(ValheimManaged)/UnityEngine.PhysicsModule.dll" Private="false" />
    <Reference Include="UnityEngine.UI" HintPath="$(ValheimManaged)/UnityEngine.UI.dll" Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule" HintPath="$(ValheimManaged)/UnityEngine.TextRenderingModule.dll" Private="false" />
    <Reference Include="UnityEngine.IMGUIModule" HintPath="$(ValheimManaged)/UnityEngine.IMGUIModule.dll" Private="false" />
    <Reference Include="Unity.TextMeshPro" HintPath="$(ValheimManaged)/Unity.TextMeshPro.dll" Private="false" />
    <Reference Include="assembly_guiutils" HintPath="$(ValheimManaged)/assembly_guiutils.dll" Private="false" />
    <Reference Include="Splatform" HintPath="$(ValheimManaged)/Splatform.dll" Private="false" />
    <Reference Include="com.rlabrecque.steamworks.net" HintPath="$(ValheimManaged)/com.rlabrecque.steamworks.net.dll" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="assets/portal-pin.png" LogicalName="portal-pin.png" />
  </ItemGroup>

  <Target Name="FailIfGameAssembliesMissing" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(ValheimManaged)/assembly_valheim.dll')"
           Text="assembly_valheim.dll not found in '$(ValheimManaged)'. Pass -p:ValheimManaged=&lt;path to Valheim_Data\Managed&gt;." />
  </Target>

  <Target Name="PackThunderstore" AfterTargets="Build" Condition="'$(Configuration)' == 'Release'">
    <RemoveDir Directories="$(PackageStageDir)" />
    <Copy SourceFiles="$(TargetPath);$(ThunderstoreDir)\README.md;$(ThunderstoreDir)\CHANGELOG.md;$(ThunderstoreDir)\icon.png" DestinationFolder="$(PackageStageDir)" />
    <WriteLinesToFile File="$(PackageStageDir)manifest.json" Overwrite="true" Lines="$([System.IO.File]::ReadAllText('$(ThunderstoreDir)\manifest.json').Replace('{VERSION}', '$(Version)').Replace('{DESCRIPTION}', '$(Description)'))" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\dist" />
    <Delete Files="$(PackageZip)" />
    <ZipDirectory SourceDirectory="$(PackageStageDir)" DestinationFile="$(PackageZip)" />
    <Message Importance="high" Text="Thunderstore package: $(PackageZip)" />
  </Target>

</Project>
